{
  "name": "digital-bookstore",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "axios": "^1.6.0",
    "formik": "^2.4.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "sass": "^1.69.5",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
